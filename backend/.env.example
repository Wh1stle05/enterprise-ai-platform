# Application
APP_NAME=Enterprise AI Platform
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/enterprise_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM
# Chat upstream: direct OpenAI or AI-Gateway /v1. Model naming:
# direct-connect mode sends the real upstream model name to the
# OpenAI-compatible SDK. The logical names below are reserved for AI-Gateway
# mode and must NOT be enabled until Gateway routing lands (T2-00 chat / T2-03
# embedding). Keep the current direct values; do not add unused config keys.
#
# | value                    | mode               | status  |
# |--------------------------|--------------------|---------|
# | gpt-4o-mini              | direct OpenAI      | current |
# | chat/gpt-4o-mini         | Gateway logical    | T2-00   |
# | chat/qwen2.5-0.5b        | Gateway/vLLM       | P1      |
# | chat/qwen2.5-1.5b        | Gateway/vLLM       | P1      |
#
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096

# Embedding upstream: independent OpenAI-compatible service (AI-Gateway /v1).
# Defaults to LLM_API_KEY/LLM_BASE_URL when blank, so direct-connect mode needs
# no new variables. For Gateway mode point both at the Gateway /v1 endpoint and
# use a Gateway service key (never the user JWT).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Direct-connect value; switch to embed/text-embedding-3-small only after
# AI-Gateway embedding routing lands (T2-03).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64

# File storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_MIN_SCORE=0.35
AUDIT_RETENTION_DAYS=90

# Bounded agent and tool confirmation
AGENT_MAX_STEPS=6
AGENT_MAX_ACTIVE_SECONDS=20
TOOL_CONFIRMATION_TTL_SECONDS=300
AGENT_TOOL_WHITELIST=["knowledge_search","create_work_ticket","query_inventory","get_leave_balance","submit_expense"]

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
